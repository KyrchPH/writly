{
  "rewrites": [
    {
      "source": "/documents",
      "destination": "/index.html"
    },
    {
      "source": "/documents/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/sign/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
