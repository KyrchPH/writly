generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  Draft
  Published
  Archived
}

enum CvDocumentType {
  ATS
  Visual
}

enum ReviewStatus {
  Pending
  Approved
}

model AdminUser {
  id            String               @id @default(uuid())
  name          String
  email         String               @unique
  passwordHash  String
  isApproved    Boolean              @default(false)
  approvedAt    DateTime?
  approvedById  String?
  approvedBy    AdminUser?           @relation("AdminUserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers AdminUser[]          @relation("AdminUserApprovals")
  resetTokens   PasswordResetToken[]
  loginLogs     AdminLoginLog[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AdminLoginLog {
  id         String    @id @default(uuid())
  userId     String
  deviceName String
  userAgent  String?
  createdAt  DateTime  @default(now())
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Project {
  id                String        @id @default(uuid())
  title             String
  category          String
  description       String
  startDate         DateTime
  endDate           DateTime?
  imageUrl          String?
  portraitImageUrl  String?
  landscapeImageUrl String?
  previewImages     String[]      @default([])
  status            ProjectStatus @default(Draft)
  isFeatured        Boolean       @default(false)
  isPinned          Boolean       @default(false)
  timeline          String?
  tags              String[]      @default([])
  highlights        String[]      @default([])
  details           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Service {
  id          String   @id @default(uuid())
  name        String
  subtitle    String?
  description String
  imageUrl    String?
  price       String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Banner {
  id          String   @id @default(uuid())
  title       String
  subtitle    String
  imageUrl    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkExperience {
  id          String   @id @default(uuid())
  company     String
  role        String
  duration    String
  location    String
  summary     String
  imageUrl    String?
  highlights  String[] @default([])
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id          String   @id @default(uuid())
  org         String
  title       String
  description String
  issueDate   DateTime
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id          String       @id @default(uuid())
  clientId    String?
  name        String
  role        String?
  rating      Int
  avatar      String?
  feedback    String
  detail      String?
  status      ReviewStatus @default(Pending)
  isPublished Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([status, updatedAt])
  @@index([isPublished, updatedAt])
}

model Client {
  id          String             @id @default(uuid())
  name        String
  email       String             @unique
  imageUrl    String?
  company     String?
  role        String?
  notes       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  invitations ReviewInvitation[]
  reviews     Review[]

  @@index([createdAt])
}

model ReviewInvitation {
  id        String   @id @default(uuid())
  clientId  String
  tokenHash String   @unique
  expiresAt DateTime
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([expiresAt])
}

model ContractTemplate {
  id          String     @id @default(uuid())
  name        String
  title       String
  content     String     @default("")
  pdfFilePath String     @default("")
  pdfFileUrl  String     @default("")
  pdfFileName String     @default("")
  pdfMimeType String     @default("application/pdf")
  pageCount   Int        @default(1)
  fields      Json       @default("[]")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  contracts   Contract[]

  @@index([updatedAt])
}

model Contract {
  id             String            @id @default(uuid())
  templateId     String?
  title          String
  recipientName  String
  recipientEmail String?
  content        String            @default("")
  pdfFilePath    String            @default("")
  pdfFileUrl     String            @default("")
  pdfFileName    String            @default("")
  pdfMimeType    String            @default("application/pdf")
  pageCount      Int               @default(1)
  fields         Json              @default("[]")
  values         Json              @default("{}")
  sentAt         DateTime?
  viewedAt       DateTime?
  submittedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  template       ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([templateId, createdAt])
  @@index([recipientEmail, createdAt])
  @@index([createdAt])
}

model ContactConfig {
  id            String   @id @default("primary")
  email         String?
  phone         String?
  instagramUrl  String?
  whatsappUrl   String?
  telegramUrl   String?
  linkedinUrl   String?
  showEmail     Boolean  @default(true)
  showPhone     Boolean  @default(true)
  showInstagram Boolean  @default(true)
  showWhatsapp  Boolean  @default(true)
  showTelegram  Boolean  @default(true)
  showLinkedin  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CvAsset {
  id              String       @id @default(uuid())
  filePath        String
  fileUrl         String
  fileName        String
  mimeType        String
  atsFilePath     String       @default("")
  atsFileUrl      String       @default("")
  atsFileName     String       @default("")
  atsMimeType     String       @default("application/pdf")
  visualFilePath  String       @default("")
  visualFileUrl   String       @default("")
  visualFileName  String       @default("")
  visualMimeType  String       @default("application/pdf")
  isActive        Boolean      @default(false)
  statusUpdatedAt DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  downloads       CvDownload[]
}

model CvOtp {
  id         String    @id @default(uuid())
  email      String
  otpHash    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model CvDownload {
  id           String         @id @default(uuid())
  cvAssetId    String
  email        String
  documentType CvDocumentType @default(Visual)
  createdAt    DateTime       @default(now())
  cvAsset      CvAsset        @relation(fields: [cvAssetId], references: [id], onDelete: Cascade)

  @@index([cvAssetId, createdAt])
  @@index([cvAssetId, documentType, createdAt])
  @@index([email, createdAt])
}

model Visitor {
  id          String         @id @default(uuid())
  visitorKey  String         @unique
  firstSeenAt DateTime       @default(now())
  lastSeenAt  DateTime       @default(now())
  visitCount  Int            @default(0)
  events      VisitorEvent[]
  errorLogs   ErrorLog[]

  @@index([lastSeenAt])
}

model VisitorEvent {
  id         String   @id @default(uuid())
  visitorId  String
  visitorKey String
  path       String
  referrer   String?
  userAgent  String?
  createdAt  DateTime @default(now())
  visitor    Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@index([visitorKey, createdAt])
}

model ErrorLog {
  id         String   @id @default(uuid())
  source     String
  message    String
  stack      String?
  details    String?
  path       String?
  url        String?
  visitorId  String?
  visitorKey String?
  userAgent  String?
  createdAt  DateTime @default(now())
  visitor    Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([source, createdAt])
  @@index([visitorId, createdAt])
  @@index([visitorKey, createdAt])
}
