{
  "name": "writly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/client",
    "packages/server"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:server dev:client",
    "dev:server": "npm run dev --workspace writly-server",
    "dev:client": "npm run dev --workspace writly-client",
    "build": "npm run build --workspace writly-server && npm run build --workspace writly-client",
    "lint": "npm run lint --workspaces"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Standalone document drafting, signing, and delivery workspace",
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "mongodb": "^7.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7"
  }
}
